<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinSupport Toolkit - V1.3 GUI Preview"
        MinWidth="1180" MinHeight="720" Width="1280" Height="780"
        WindowStartupLocation="CenterScreen" Background="#F5F3FA"
        FontFamily="Segoe UI, Microsoft YaHei UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#29263D" />
        <SolidColorBrush x:Key="Muted" Color="#77738D" />
        <SolidColorBrush x:Key="Purple" Color="#6654B8" />
        <SolidColorBrush x:Key="PurpleLight" Color="#EEEAFE" />
        <SolidColorBrush x:Key="CyanLight" Color="#E3F7F8" />
        <SolidColorBrush x:Key="PinkLight" Color="#F8EAF4" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,4,0,4" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#E9E6FF" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Margin" Value="8,2,8,2" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#6654B8" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="SoftButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#EEEAFE" />
            <Setter Property="Foreground" Value="#4C3C9D" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="318" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#302B53" Padding="18,24">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Separator Margin="0,8,0,12" Background="#5A5480" />
                    <TextBlock Text="权限状态" Foreground="#AAA5C9" FontSize="12" />
                    <TextBlock x:Name="PermissionText" Text="普通用户" Foreground="White" FontSize="13" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="WinSupport" Foreground="White" FontSize="24" FontWeight="Bold" />
                    <TextBlock Text="Toolkit" Foreground="#BDB6EF" FontSize="16" />
                    <TextBlock Text="V1.3 GUI Preview" Foreground="#AAA5C9" FontSize="12" Margin="0,3,0,28" />
                    <Button x:Name="NavOverview" Tag="overview" Style="{StaticResource NavButton}" Content="🩺  总览" />
                    <Button x:Name="NavDiagnosis" Tag="diagnosis" Style="{StaticResource NavButton}" Content="🔍  全面诊断" />
                    <Button x:Name="NavNetwork" Tag="网络" Style="{StaticResource NavButton}" Content="网络" />
                    <Button x:Name="NavPrinter" Tag="打印机" Style="{StaticResource NavButton}" Content="打印机" />
                    <Button x:Name="NavSystem" Tag="系统" Style="{StaticResource NavButton}" Content="系统" />
                    <Button x:Name="NavDisk" Tag="磁盘" Style="{StaticResource NavButton}" Content="磁盘" />
                    <Button x:Name="NavSoftware" Tag="软件" Style="{StaticResource NavButton}" Content="软件" />
                    <Button x:Name="NavDevice" Tag="设备" Style="{StaticResource NavButton}" Content="电脑相关" />
                    <Button x:Name="NavReports" Tag="reports" Style="{StaticResource NavButton}" Content="📋  报告" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="30,28">
            <StackPanel>
                <TextBlock x:Name="PageTitle" Text="总览" FontSize="30" FontWeight="SemiBold" />
                <TextBlock x:Name="PageSubtitle" Text="欢迎回来，先看看这台电脑的状态吧。" Foreground="{StaticResource Muted}" FontSize="14" Margin="0,5,0,22" />

                <StackPanel x:Name="OverviewPanel">
                    <Border Background="White" CornerRadius="14" Padding="20" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="当前电脑" Foreground="{StaticResource Muted}" FontSize="12" />
                                <TextBlock x:Name="ComputerNameText" Text="读取中..." FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0" />
                                <TextBlock x:Name="ComputerMetaText" Text="" Foreground="{StaticResource Muted}" Margin="0,6,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock Text="总体健康状态" Foreground="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Right" />
                                <TextBlock x:Name="OverallStatusText" Text="未检测" FontSize="24" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,4,0,0" />
                                <TextBlock x:Name="CountsText" Text="问题 0 项 · 注意 0 项" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <WrapPanel x:Name="StatusCardsPanel" />
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button x:Name="StartDiagnosisButton" Style="{StaticResource PrimaryButton}" Content="开始全面诊断" Margin="0,0,8,0" />
                        <Button x:Name="ViewResultsButton" Style="{StaticResource SoftButton}" Content="查看本次结果" Margin="0,0,8,0" />
                        <Button x:Name="ExportOverviewButton" Style="{StaticResource SoftButton}" Content="导出报告" Margin="0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="DiagnosisPanel" Visibility="Collapsed">
                    <Border Background="White" CornerRadius="14" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="全面诊断" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock x:Name="DiagnosisStatusText" Text="准备开始" Foreground="{StaticResource Muted}" Margin="0,5,0,16" />
                            <StackPanel x:Name="DiagnosisStepsPanel" />
                            <Button x:Name="RunDiagnosisAgainButton" Style="{StaticResource PrimaryButton}" Content="重新诊断" HorizontalAlignment="Left" Margin="0,14,0,0" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="ProblemsBorder" Background="#FFF8F2" CornerRadius="14" Padding="20" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="需要留意的项目" FontSize="18" FontWeight="SemiBold" />
                            <ItemsControl x:Name="ProblemsItems" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="DetailPanel" Visibility="Collapsed">
                    <Border Background="White" CornerRadius="14" Padding="20">
                        <StackPanel>
                            <TextBlock x:Name="DetailHeading" Text="分类详情" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock x:Name="DetailStatusText" Text="未检测" Foreground="{StaticResource Muted}" Margin="0,5,0,16" />
                            <ItemsControl x:Name="DetailItems" />
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button x:Name="RefreshCategoryButton" Style="{StaticResource SoftButton}" Content="重新检测" Margin="0,0,8,0" />
                                <Button x:Name="CompatibilityButton" Style="{StaticResource SoftButton}" Content="在兼容模式打开" Margin="0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="ReportsPanel" Visibility="Collapsed">
                    <Border Background="White" CornerRadius="14" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="本次诊断摘要" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock x:Name="ReportSummaryText" Text="尚未完成诊断。" Foreground="{StaticResource Muted}" Margin="0,6,0,12" />
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="ExportTxtButton" Style="{StaticResource SoftButton}" Content="导出 TXT" Margin="0,0,8,0" />
                                <Button x:Name="ExportJsonButton" Style="{StaticResource SoftButton}" Content="导出 JSON" Margin="0,0,8,0" />
                                <Button x:Name="ExportBothButton" Style="{StaticResource PrimaryButton}" Content="导出 TXT + JSON" Margin="0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Background="White" CornerRadius="14" Padding="20">
                        <StackPanel>
                            <TextBlock Text="历史报告" FontSize="18" FontWeight="SemiBold" />
                            <ListBox x:Name="HistoryReportsList" BorderThickness="0" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="PlaceholderPanel" Visibility="Collapsed">
                    <Border Background="White" CornerRadius="14" Padding="24">
                        <StackPanel>
                            <TextBlock x:Name="PlaceholderTitle" Text="工具" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock Text="这个页面会逐步接入现有工具。当前功能可通过兼容模式打开，所有原有确认和权限逻辑保持不变。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,8,0,18" />
                            <Button x:Name="PlaceholderCompatibilityButton" Style="{StaticResource PrimaryButton}" Content="在兼容模式打开" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Column="2" Margin="0,28,28,28" Background="#E9E4FA" CornerRadius="18" Padding="24">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="IT Assistant" FontSize="24" FontWeight="SemiBold" Foreground="#4C3C9D" HorizontalAlignment="Center" />
                <TextBlock Text="🧑‍💻  🛠️  ✨" FontSize="48" HorizontalAlignment="Center" Margin="0,24" />
                <TextBlock x:Name="AssistantStatusText" Text="准备好了，开始检查这台电脑吧 ✨" TextWrapping="Wrap" TextAlignment="Center" FontSize="16" Foreground="#4C3C9D" />
                <TextBlock Text="后续可替换为本地 PNG 插画" TextAlignment="Center" Foreground="#8278B4" FontSize="12" Margin="0,30,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
